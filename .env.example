# Umgebungsvariablen – kopiere diese Datei nach .env und passe die Werte an.

# Starkes, zufälliges Secret für die JWT-Signierung (PFLICHT ändern!)
# z.B. erzeugen mit:  openssl rand -hex 32
JWT_SECRET=bitte_hier_ein_langes_zufaelliges_secret_einsetzen

# Gültigkeitsdauer der Login-Token
JWT_EXPIRES_IN=30d

# Zeitfenster (Stunden), in dem Helfer eigene Einträge/Termine noch korrigieren dürfen
EDIT_WINDOW_HOURS=24

# Initialer Administrator (nur beim ersten Seed verwendet) – PIN danach in der App ändern!
ADMIN_USERNAME=admin
ADMIN_PIN=1234

# Demodaten beim Seed anlegen? (1 = ja) – für Produktivbetrieb auf 0 lassen
SEED_DEMO=0
